{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Bash(*cmdkey*)",
      "Bash(*vaultcmd*)",
      "Bash(*manage-bde*)",
      "Bash(*dsregcmd*)",
      "Bash(*reg query HKLM\\SAM*)",
      "Bash(*reg query HKLM\\SECURITY*)",
      "Bash(*reg save*)",
      "Bash(*mimikatz*)",
      "Bash(*procdump*)",
      "Bash(*rundll32*)",
      "Bash(*Get-StoredCredential*)",
      "Bash(*CredentialManager*)",
      "Bash(*DPAPI*)",
      "Bash(*ProtectedData*)",
      "Bash(*Get-Secret*)",
      "Bash(*Get-LapsADPassword*)",
      "Bash(*Get-LapsAADPassword*)",
      "Bash(*DeviceLocalCredential*)",
      "Bash(*deviceLocalCredential*)",
      "Bash(*BitlockerRecoveryKey*)",
      "Bash(*recoveryKeys*)",
      "Bash(*ms-Mcs-AdmPwd*)",
      "Bash(*msLAPS-Password*)",
      "Bash(*msLAPS-EncryptedPassword*)",
      "Bash(*msFVE-RecoveryPassword*)",
      "PowerShell(*cmdkey*)",
      "PowerShell(*vaultcmd*)",
      "PowerShell(*manage-bde*)",
      "PowerShell(*dsregcmd*)",
      "PowerShell(*reg query HKLM\\SAM*)",
      "PowerShell(*reg query HKLM\\SECURITY*)",
      "PowerShell(*reg save*)",
      "PowerShell(*mimikatz*)",
      "PowerShell(*procdump*)",
      "PowerShell(*rundll32*)",
      "PowerShell(*Get-StoredCredential*)",
      "PowerShell(*CredentialManager*)",
      "PowerShell(*DPAPI*)",
      "PowerShell(*ProtectedData*)",
      "PowerShell(*Get-Secret*)",
      "PowerShell(*Get-LapsADPassword*)",
      "PowerShell(*Get-LapsAADPassword*)",
      "PowerShell(*DeviceLocalCredential*)",
      "PowerShell(*deviceLocalCredential*)",
      "PowerShell(*BitlockerRecoveryKey*)",
      "PowerShell(*recoveryKeys*)",
      "PowerShell(*ms-Mcs-AdmPwd*)",
      "PowerShell(*msLAPS-Password*)",
      "PowerShell(*msLAPS-EncryptedPassword*)",
      "PowerShell(*msFVE-RecoveryPassword*)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/AppData/Local/.IdentityService/**)",
      "Read(~/AppData/Roaming/Microsoft/Protect/**)",
      "Read(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Vault/**)",
      "Read(**/.ssh/**)",
      "Read(**/.azure/**)",
      "Read(**/.aws/credentials)",
      "Read(**/.aws/sso/cache/**)",
      "Read(**/.aws/cli/cache/**)",
      "Read(**/.claude/.credentials.json)",
      "Read(**/.codex/auth.json)",
      "Read(**/.secrets/**)",
      "Read(**/*.dpapi)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/AppData/Local/.IdentityService/**)",
      "Read(**/AppData/Roaming/Microsoft/Protect/**)",
      "Read(**/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(**/AppData/Local/Microsoft/Credentials/**)",
      "Read(**/AppData/Local/Microsoft/Vault/**)"
    ]
  }
}
